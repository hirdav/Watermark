# Postgres connection string (local Postgres install, or the Railway addon's URL).
DATABASE_URL="postgresql://user:password@localhost:5432/watermark"

# Auth.js / NextAuth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Local disk storage for uploaded/watermarked images.
# On Railway, mount a persistent volume at this path.
STORAGE_DIR="./storage"

# Transactional email (password reset, contact form) via Resend's HTTPS API —
# https://resend.com. Optional for local dev — when RESEND_API_KEY is unset,
# emails are logged to the server console instead of sent. Uses an HTTPS API
# rather than SMTP because Railway (and most PaaS hosts) block outbound SMTP
# ports on lower tiers; HTTPS is never blocked. See README for setup.
RESEND_API_KEY=""
MAIL_FROM="Proof <no-reply@mail.yourdomain.com>"
# Inbox that contact-page messages are sent to.
CONTACT_EMAIL="you@yourdomain.com"

# Google Drive import — lets users paste a Drive folder/file link (shared as "Anyone
# with the link") to pull photos in instead of uploading from disk. Optional — without
# it, the "Import from Google Drive" field just returns an error. See README for setup.
GOOGLE_API_KEY=""

# Razorpay (test mode) — see README for how to obtain these.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_ID_PRO=""
RAZORPAY_PLAN_ID_STUDIO=""
